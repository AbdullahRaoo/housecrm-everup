{
  "name": "crm-frontend",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "lint": "eslint .",
    "preview": "vite preview",
    "server": "nodemon --experimental-modules server/index.js",
    "server:prod": "node --experimental-modules server/index.js",
    "dev:all": "concurrently \"npm run dev\" \"npm run server\"",
    "seed": "node --experimental-modules server/scripts/seed.js",
    "setup": "npm run seed && npm run dev:all",
    "start": "npm run dev:all"
  },
  "dependencies": {
    "@googlemaps/js-api-loader": "^1.16.8",
    "@tailwindcss/vite": "^4.0.3",
    "@types/google.maps": "^3.58.1",
    "axios": "^1.8.4",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-hook-form": "^7.54.2",
    "react-router-dom": "^7.1.5",
    "recharts": "^2.15.1",
    "date-fns": "^2.30.0"
  },
  "devDependencies": {
    "@eslint/js": "^9.17.0",
    "@types/node": "^22.13.1",
    "@types/react": "^18.3.18",
    "@types/react-dom": "^18.3.5",
    "@vitejs/plugin-react": "^4.3.4",
    "concurrently": "^8.2.2",
    "eslint": "^9.17.0",
    "eslint-plugin-react-hooks": "^5.0.0",
    "eslint-plugin-react-refresh": "^0.4.16",
    "globals": "^15.14.0",
    "nodemon": "^3.1.9",
    "typescript": "~5.6.2",
    "typescript-eslint": "^8.18.2",
    "vite": "^6.0.5"
  }
}