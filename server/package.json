{
  "name": "crm-server",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "lint": "eslint .",
    "preview": "vite preview",
    "server": "nodemon --experimental-modules server/index.js",
    "server:prod": "node --experimental-modules server/index.js",
    "dev:all": "concurrently \"npm run dev\" \"npm run server\"",
    "seed": "node --experimental-modules server/scripts/seed.js",
    "setup": "npm run seed && npm run dev:all",
    "start": "nodemon index.js"
  },
  "dependencies": {
    "body-parser": "^2.2.0",
    "cloudinary": "^2.6.0",
    "cors": "^2.8.5",
    "dotenv": "^16.5.0",
    "express": "^4.18.2",
    "jsonwebtoken": "^9.0.2",
    "mongoose": "^8.13.2",
    "multer": "^1.4.5-lts.2",
    "react": "^18.3.1",
    "xlsx": "^0.18.5"
  },
  "devDependencies": {
    "@types/node": "^22.13.1",
    "concurrently": "^8.2.2",
    "eslint": "^9.17.0",
    "nodemon": "^3.1.9",
    "vite": "^6.0.5"
  }
}